# Copy this to .env.local for local dev (gitignored).

# This site's own public base URL - used for canonical links, OG/Twitter
# absolute URLs, and sitemap.xml/robots.txt. Set to the real domain once
# this site is deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Where the "Plan a trip here" CTA sends visitors - the existing CRA app's
# trip planner. No real production domain exists for that app yet (only
# localhost:3000 in backend/.env), so this defaults to the same local dev
# convention. Update this once the CRA app has a real domain - no code
# change needed, just this value.
#
# This is a plain link, not pre-filled: the CRA trip planner has no
# mechanism today to read a destination from the URL (it only reads
# React Router navigation `state`, and even the login-redirect flow drops
# the query string - see site/lib/destinations.js). Visitors land on an
# empty wizard. Revisit once the CRA app supports a real pre-fill param.
NEXT_PUBLIC_APP_URL=http://localhost:3000/trip-planner
