# ==============================================================================
# EYV Backend Environment Variables
# Copy to backend/.env for local development.
# For production deploys on Railway, set these in Railway's service variables.
# ==============================================================================

# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=eyv_database

# CORS allowlist (required at startup - comma-separated origins, no wildcards)
CORS_ORIGINS=http://localhost:3000

# Security Tokens & Keys (Strictly required at boot)
# WALLET_URL_SIGNING_SECRET signs short-lived wallet download URLs
WALLET_URL_SIGNING_SECRET=local-dev-wallet-signing-secret

# ADMIN_API_KEY authenticates the EYV Admin surface (/api/admin/*).
# Set it in backend/.env for local dev and in Railway's service variables for deploys.
ADMIN_API_KEY=local-dev-admin-api-key

# REVENUECAT_WEBHOOK_AUTH_KEY authenticates incoming RevenueCat subscription webhooks
REVENUECAT_WEBHOOK_AUTH_KEY=local-dev-revenuecat-webhook-key

# Internal Service Tokens (authenticate internal agent communication)
INTERNAL_TICKET_API_TOKEN=local-dev-internal-ticket-token
INTERNAL_ANALYTICS_API_TOKEN=local-dev-internal-analytics-token
JARVIS_QUEUE_API_TOKEN=local-dev-jarvis-queue-token

# Admin & Notification Email
ADMIN_EMAIL=kandrikaabhinay@gmail.com

# LLM Providers (Optional for local dev - features degrade gracefully if unset)
GEMINI_API_KEY=

# Payments (Optional for local dev - mock mode used when unset)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Travel Provider APIs (Optional - fallback mocks used when unset)
DUFFEL_API_KEY=
SERPAPI_KEY=
IGNAV_API_KEY=

# Social Media Marketing Channels (Optional - sandbox mode used when unset)
BUFFER_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
